# Lumera Vault environment configuration
# Copy this file to .env and fill in your values

# ── Lumera Cascade via cascade-api (https://github.com/kaleababayneh/cascade-api)
# The API key is a quota-capped bearer token issued by the cascade-api operator.
# NOTE: VITE_* vars are embedded in the client bundle — use a quota-capped key.
VITE_CASCADE_API_BASE=https://api.lumera.help
VITE_CASCADE_API_KEY=

# ── Midnight (preprod) via the 1AM wallet (https://1am.xyz)
VITE_MIDNIGHT_NETWORK_ID=preprod

# Used by the wallet-less Verify tab; when a wallet is connected the wallet's
# own configuration takes precedence.
VITE_INDEXER_URI=https://indexer.preprod.midnight.network/api/v4/graphql
VITE_INDEXER_WS_URI=wss://indexer.preprod.midnight.network/api/v4/graphql/ws

# Registry contract address on preprod (set after deploying from the Registry tab)
VITE_CONTRACT_ADDRESS=
